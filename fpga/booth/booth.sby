# Formal verification of booth.vhd and booth_radix2.vhd, see booth.psl. This
# file is run by SymbiYosys (see https://github.com/YosysHQ/sby), and its
# format is described in
# https://yosyshq.readthedocs.io/projects/sby/en/latest/reference.html
#
# The prove tasks use k-induction, so the properties are proven for every
# clock cycle, not just for a bounded number of them. The depth option is k.
# The base case only checks the first k clock cycles after the reset, so a bug
# that needs more clock cycles to show up (e.g. two products) makes the
# induction step fail instead (status UNKNOWN). The trace of the induction
# step (make show_induct) then starts from an arbitrary state. A bmc task with
# a larger depth finds a trace from the reset instead, but with a depth of 20
# it takes several minutes.
# The tasks use G_DATA_SIZE=8, and G_DATA_SIZE=7 for an odd size, where Q is
# sign-extended. booth_csa.vhd is verified with G_DIGITS of 1, 2, and 3, and
# with blocks of 3 bits in the final adder (G_CPA_SIZE=3), so that it has
# several blocks. The solver is given the multiplication a*b directly, which
# is slow for larger sizes: with G_DATA_SIZE=16 the proof does not finish
# within 10 minutes. The design is the same for every size, and the
# simulation tests larger sizes.
#
# The engine smtbmc uses the Boolector SMT solver (see
# https://github.com/Boolector/boolector), which handles the multiplication
# much better than the default solver Yices: with Yices, the tasks with
# G_DATA_SIZE=8 do not finish within 10 minutes, but with Boolector they take
# less than a minute.
#
# The cover tasks show that the cover statements in booth.psl can be reached.
# With G_DATA_SIZE=8, radix 2 takes 8 clock cycles for each product, and some
# of the cover statements need two products, so the depth must be larger than
# that.
#
# The files are read with the GHDL plugin for Yosys (see
# https://github.com/ghdl/ghdl-yosys-plugin). booth_radix2.psl is generated
# from booth.psl by the Makefile.

[tasks]
prove4
prove4_odd
prove2
prove_csa1
prove_csa2
prove_csa2_odd
prove_csa3
cover4
cover2
cover_csa2

[options]
prove4: mode prove
prove4: depth 4
prove4_odd: mode prove
prove4_odd: depth 4
prove2: mode prove
prove2: depth 4
prove_csa1: mode prove
prove_csa1: depth 4
prove_csa2: mode prove
prove_csa2: depth 4
prove_csa2_odd: mode prove
prove_csa2_odd: depth 4
prove_csa3: mode prove
prove_csa3: depth 4
cover4: mode cover
cover4: depth 16
cover2: mode cover
cover2: depth 24
cover_csa2: mode cover
cover_csa2: depth 12

[engines]
smtbmc boolector

[script]
prove4: ghdl --std=08 -gG_DATA_SIZE=8 booth.vhd booth.psl -e booth
prove4_odd: ghdl --std=08 -gG_DATA_SIZE=7 booth.vhd booth.psl -e booth
cover4: ghdl --std=08 -gG_DATA_SIZE=8 booth.vhd booth.psl -e booth
prove2: ghdl --std=08 -gG_DATA_SIZE=8 booth_radix2.vhd booth_radix2.psl -e booth_radix2
cover2: ghdl --std=08 -gG_DATA_SIZE=8 booth_radix2.vhd booth_radix2.psl -e booth_radix2
prove_csa1: ghdl --std=08 -gG_DATA_SIZE=8 -gG_DIGITS=1 -gG_CPA_SIZE=3 booth_csa.vhd booth_csa.psl -e booth_csa
prove_csa2: ghdl --std=08 -gG_DATA_SIZE=8 -gG_DIGITS=2 -gG_CPA_SIZE=3 booth_csa.vhd booth_csa.psl -e booth_csa
prove_csa2_odd: ghdl --std=08 -gG_DATA_SIZE=7 -gG_DIGITS=2 -gG_CPA_SIZE=3 booth_csa.vhd booth_csa.psl -e booth_csa
prove_csa3: ghdl --std=08 -gG_DATA_SIZE=8 -gG_DIGITS=3 -gG_CPA_SIZE=3 booth_csa.vhd booth_csa.psl -e booth_csa
cover_csa2: ghdl --std=08 -gG_DATA_SIZE=8 -gG_DIGITS=2 -gG_CPA_SIZE=3 booth_csa.vhd booth_csa.psl -e booth_csa
prove4: prep -top booth
prove4_odd: prep -top booth
cover4: prep -top booth
prove2: prep -top booth_radix2
cover2: prep -top booth_radix2
prove_csa1: prep -top booth_csa
prove_csa2: prep -top booth_csa
prove_csa2_odd: prep -top booth_csa
prove_csa3: prep -top booth_csa
cover_csa2: prep -top booth_csa

[files]
booth.vhd
booth.psl
booth_radix2.vhd
booth_radix2.psl
booth_csa.vhd
booth_csa.psl
