# Formal verification of c64_sqrt2.vhd, see c64_sqrt2.psl. This file is run
# by SymbiYosys (see https://github.com/YosysHQ/sby), and its format is
# described in
# https://yosyshq.readthedocs.io/projects/sby/en/latest/reference.html
#
# The prove task uses k-induction (see
# https://doi.org/10.1007/3-540-40922-X_8), so the properties are proven for
# every clock cycle, not just for a bounded number of them. The depth option
# is k.
#
# The cover task shows that the cover statements in c64_sqrt2.psl can be
# reached.
#
# The engine smtbmc uses the Boolector SMT solver (see
# https://github.com/Boolector/boolector).
#
# "memory_map -rom-only" (see
# https://yosyshq.readthedocs.io/projects/yosys/en/latest/cmd/index_passes_memory.html#cmd-memory_map)
# turns the table of the initial approximation (C_INV_SQRT) into logic. The
# initial contents of a memory only hold in the first clock cycle, but
# induction starts from an arbitrary clock cycle, and could otherwise use any
# contents.
#
# The script reads the VHDL and PSL files with the GHDL plugin for Yosys (see
# https://github.com/ghdl/ghdl-yosys-plugin). dsp.vhd is read first, since
# c64_sqrt2.vhd uses it.

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 3
cover: mode cover
cover: depth 12

[engines]
smtbmc boolector

[script]
ghdl --std=08 dsp.vhd c64_sqrt2.vhd c64_sqrt2.psl -e c64_sqrt2
prep -top c64_sqrt2
memory_map -rom-only

[files]
dsp.vhd
c64_sqrt2.vhd
c64_sqrt2.psl
