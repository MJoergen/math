# Formal verification of fast_divide.vhd, see fast_divide.psl. This file is
# run by SymbiYosys (see https://github.com/YosysHQ/sby), and its format is
# described in
# https://yosyshq.readthedocs.io/projects/sby/en/latest/reference.html
#
# The prove task uses k-induction (see
# https://doi.org/10.1007/3-540-40922-X_8), so the properties are proven for
# every clock cycle, not just for a bounded number of them. The depth option
# is k.
#
# The cover task shows that the cover statements in fast_divide.psl can be
# reached.
#
# The engine smtbmc uses the Boolector SMT solver (see
# https://github.com/Boolector/boolector).
#
# The script reads the VHDL and PSL files with the GHDL plugin for Yosys (see
# https://github.com/ghdl/ghdl-yosys-plugin).

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 3
cover: mode cover
cover: depth 12

[engines]
smtbmc boolector

[script]
ghdl --std=08 fast_divide.vhd fast_divide.psl -e fast_divide
prep -top fast_divide

[files]
fast_divide.vhd
fast_divide.psl
