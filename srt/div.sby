# Formal verification of div.vhd, see div.psl.
#
# The prove tasks use k-induction, so the properties are proven for every
# clock cycle, not just for a bounded number of them. "prove" uses
# G_SIZE=16, which matches div.gtkw, and "prove32" uses G_SIZE=32, as in
# srt_float.
#
# The cover task shows that the cover statements in div.psl can be reached.
# With G_SIZE=16 a division takes 18 iterations, and the result is ready in
# step 19, so the depth must be larger than that.
#
# "memory_map -rom-only" turns the quotient digit table (a ROM) into logic.
# The initial contents of a memory only hold in the first clock cycle, but
# induction starts from an arbitrary clock cycle, and could otherwise use
# any table contents.

[tasks]
cover
prove
prove32

[options]
cover: mode cover
cover: depth 22
prove: mode prove
prove: depth 4
prove32: mode prove
prove32: depth 4

[engines]
smtbmc

[script]
cover: ghdl --std=08 -gG_SIZE=16 pla.vhd pla_pentium.vhd div.vhd div.psl -e div
prove: ghdl --std=08 -gG_SIZE=16 pla.vhd pla_pentium.vhd div.vhd div.psl -e div
prove32: ghdl --std=08 -gG_SIZE=32 pla.vhd pla_pentium.vhd div.vhd div.psl -e div
prep -top div
memory_map -rom-only

[files]
div.psl
div.vhd
pla.vhd
pla_pentium.vhd
