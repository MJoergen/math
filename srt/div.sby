# Formal verification of div.vhd, see div.psl.
#
# With G_SIZE=16 a division takes 18 iterations, and the result is ready in
# step 19. The depth must be larger than that, so the BMC covers a complete
# division.

[tasks]
cover
bmc

[options]
cover: mode cover
cover: depth 22
bmc: mode bmc
bmc: depth 22

[engines]
smtbmc

[script]
ghdl --std=08 -gG_SIZE=16 div.vhd div.psl pla.vhd -e div
prep -top div

[files]
div.psl
div.vhd
pla.vhd
