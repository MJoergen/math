-- Formal verification of srt_core.vhd. Run with "make formal".
-- In addition to the properties in this file, the assertions inside
-- srt_core.vhd (e.g. in the function get_n) are verified too.
--
-- The properties are proven with k-induction (see srt_core.sby): If they hold
-- in a few consecutive clock cycles, then they also hold in the next one.
-- This works because the assertions below check invariants in every clock
-- cycle, so each clock cycle is a small local step. Some extra assertions (marked
-- "for induction") rule out states that can never be reached, but from which
-- induction could otherwise start.

vunit srt_core_inst (srt_core(synthesis))
{
   -- set all declarations to run on clk_i
   default clock is rising_edge(clk_i);

   -----------------------------
   -- AUXILIARY SIGNALS
   -----------------------------

   -- In the following n, d, and q are treated as integers, i.e. the fixed
   -- point values scaled by 2^(G_SIZE-4), 2^(G_SIZE-4), and 2^(2*G_SIZE+2).
   -- The dividend of the current division is called N.
   --
   -- To verify the result, we want to check that N*2^(2*G_SIZE+2) - q*d is
   -- small. However, the SMT solvers are very slow at multiplication. Instead,
   -- the signals f_q and f_qd below are updated alongside the divider, using
   -- the same quotient digits:
   --    f_q  := 4*f_q  + digit
   --    f_qd := 4*f_qd + digit*d
   -- So by construction f_qd = f_q*d. Since digit*d is just a shift of d,
   -- this uses only additions. We then check that m_q_o = f_q, and that
   -- N*2^(2*G_SIZE+2) - f_qd is small.
   --
   -- To help the solver, we also check in every clock cycle that the partial
   -- remainder satisfies
   --    n = f_n4 - 4*f_qd, where f_n4 = N*4^k
   -- after k iterations. This follows by induction from n := 4*(n - digit*d).
   -- The solver assumes that the assertions hold in all previous clock
   -- cycles, so each clock cycle is a small local check. For the same reason,
   -- the final result is checked one clock cycle after the division is
   -- finished.

   constant C_W : natural := 3 * G_SIZE + 6;

   -- Copy of the dividend of the current division
   signal f_n  : std_logic_vector(G_SIZE - 1 downto 0);

   -- The dividend times 4^k
   signal f_n4 : std_logic_vector(C_W - 1 downto 0);

   -- The quotient calculated from the digits, and the quotient times d.
   -- f_qd is two's complement.
   signal f_q  : std_logic_vector(2 * G_SIZE + 3 downto 0);
   signal f_qd : std_logic_vector(C_W - 1 downto 0);

   -- Set after the first clock cycle, when the above signals are valid
   signal f_started : std_logic := '0';

   -- Whether f_n4 = N*4^k
   signal f_n4_ok : boolean;

   -- Whether the partial remainder satisfies n = f_n4 - 4*f_qd
   signal f_inv_ok : boolean;

   -- Whether the partial remainder satisfies |n/d| < 8/3, i.e. 3*|n| < 8*d
   signal f_rem_ok : boolean;

   -- Whether the quotient is correct, i.e. whether 3*|err| < 2*d, where
   -- err = N*2^(2*G_SIZE+2) - q*d. This means that the quotient differs from
   -- the exact value N/d by less than 2/3 of the least significant bit of
   -- m_q_o.
   signal f_res_ok : boolean;

   f_track_proc : process (clk_i)
      variable q_v  : std_logic_vector(2 * G_SIZE + 3 downto 0);
      variable qd_v : std_logic_vector(C_W - 1 downto 0);
   begin
      if rising_edge(clk_i) then
         if state = BUSY_ST then
            f_n4 <= f_n4(C_W - 3 downto 0) & "00";

            q_v  := f_q(2 * G_SIZE + 1 downto 0) & "00";
            qd_v := f_qd(C_W - 3 downto 0) & "00";

            case pla_q is

               when -2 =>
                  f_q  <= q_v - 2;
                  f_qd <= qd_v - (d & "0");

               when -1 =>
                  f_q  <= q_v - 1;
                  f_qd <= qd_v - d;

               when 1 =>
                  f_q  <= q_v + 1;
                  f_qd <= qd_v + d;

               when 2 =>
                  f_q  <= q_v + 2;
                  f_qd <= qd_v + (d & "0");

               when others =>
                  f_q  <= q_v;
                  f_qd <= qd_v;

            end case;

         end if;

         if s_valid_i = '1' and s_ready_o = '1' then
            f_n  <= s_n_i;
            f_n4 <= (C_W - 1 downto G_SIZE => '0') & s_n_i;
            f_q  <= (others => '0');
            f_qd <= (others => '0');
         end if;

         f_started <= '1';
      end if;
   end process f_track_proc;

   f_check_proc : process (all)
      variable n_ext_v : std_logic_vector(C_W + 2 downto 0);
      variable n_abs_v : std_logic_vector(G_SIZE - 1 downto 0);
      variable err_v   : std_logic_vector(C_W - 1 downto 0);
      variable abs_v   : std_logic_vector(C_W - 1 downto 0);
   begin
      -- Check f_n4. During a division k = iter, and after the division
      -- k = C_NUM_ITERS.
      if state = BUSY_ST then
         f_n4_ok <= f_n4 = ((C_W - 1 downto G_SIZE => '0') & f_n) sll (2 * iter);
      else
         f_n4_ok <= f_n4 = ((C_W - 1 downto G_SIZE => '0') & f_n) sll (2 * C_NUM_ITERS);
      end if;

      -- Check n = f_n4 - 4*f_qd. This is calculated with three extra bits,
      -- so there is no overflow.
      n_ext_v  := (C_W + 2 downto G_SIZE => n(G_SIZE - 1)) & n;
      f_inv_ok <= n_ext_v = ("000" & f_n4) - (f_qd(C_W - 1) & f_qd & "00");

      -- Check 3*|n| < 8*d
      n_abs_v  := abs_slv(n);
      f_rem_ok <= ("00" & n_abs_v) + ("0" & n_abs_v & "0") < (d & "000");

      -- Check 3*|err| < 2*d
      err_v := ("0000" & f_n & (2 * G_SIZE + 1 downto 0 => '0')) - f_qd;
      if err_v(err_v'left) = '0' then
         abs_v := err_v;
      else
         abs_v := 0 - err_v;
      end if;
      f_res_ok <= ("0" & abs_v & "0") + ("00" & abs_v) < (d & "0");
   end process f_check_proc;


   -----------------------------
   -- ASSERTIONS ABOUT OUTPUTS
   -----------------------------

   -- Verify the helper signals in every clock cycle. m_q_o is quot with the
   -- stored digit appended, i.e. all the digits so far.
   f_n4_check  : assert always f_started = '1' -> f_n4_ok;
   f_invariant : assert always f_started = '1' -> f_inv_ok;
   f_remainder : assert always f_started = '1' -> f_rem_ok;
   f_digits    : assert always f_started = '1' -> m_q_o = f_q and quot_m1 = quot - 1;

   -- For induction: The stored divisor and dividend are valid
   f_d_norm    : assert always f_started = '1' -> d(G_SIZE-1 downto G_SIZE-4) = "0001";
   f_n_valid   : assert always f_started = '1' -> (f_n(G_SIZE-1 downto G_SIZE-4) = "0001" or f_n = 0);

   -- For induction: The first division starts in the first clock cycle, see
   -- f_start_first below
   f_idle_first : assert always f_started = '0' -> state = IDLE_ST;

   -- For induction: state holds one of its three values. It is stored in two
   -- bits, so induction could otherwise start from the fourth value.
   f_state : assert always state = IDLE_ST or state = BUSY_ST or state = DONE_ST;

   -- While the result is valid, verify that the quotient matches the digits.
   -- This is modulo 2^(2*G_SIZE+4), but f_result below shows that the true
   -- quotient is less than 2, so there is no overflow.
   f_quotient : assert always m_valid_o = '1' -> m_q_o = f_q;

   -- One clock cycle after the result is valid, verify that the quotient is
   -- correct. No new division can start while the result is valid, so the
   -- helper signals still belong to this division.
   f_result : assert always {m_valid_o = '1'} |=> {f_res_ok};

   -- The handshake: The result stays valid and unchanged until it is taken
   f_hold : assert always {m_valid_o = '1' and m_ready_i = '0'} |=>
      {m_valid_o = '1' and m_q_o = prev(m_q_o)};


   -----------------------------
   -- ASSUMPTIONS ABOUT INPUTS
   -----------------------------

   -- Require a division to start at startup.
   f_reset : assume {s_valid_i = '1'};

   -- For induction: The helper signals are only invalid before the first
   -- division is started, i.e. in the first clock cycle, where f_reset
   -- requires a start anyway.
   f_start_first : assume always f_started = '0' -> s_valid_i = '1';

   -- Require valid input: The divisor must be normalized, and the dividend
   -- must be either normalized or zero.
   f_valid : assume always s_valid_i = '1' ->
      ((s_n_i(G_SIZE-1 downto G_SIZE-4) = "0001" or s_n_i = 0) and
        s_d_i(G_SIZE-1 downto G_SIZE-4) = "0001");


   --------------------------------------------
   -- COVER STATEMENTS TO VERIFY REACHABILITY
   --------------------------------------------

   -- The partial remainder n uses 4 integer bits (including the sign), so the
   -- top 12 bits are n truncated to a multiple of 1/256.

   -- Verify that n >= 4.34375 (= 0100.01011000) can be reached. The upper
   -- limit 4.5 needs the table to see n one row too low (because of the
   -- carry-save form) at the right moment, so it is hard to approach: the
   -- model reaches n=4.354 when dividing 0x116B/0x1FFF (with G_SIZE=16), after
   -- 14 iterations. Reached in step 5.
   f_large_n : cover {n(G_SIZE-1) = '0' and n(G_SIZE-2 downto G_SIZE-12) >= "10001011000"};

   -- Verify that n=-4.5 (= 1011.10000000, i.e. n truncated to a multiple of
   -- 1/256) can be reached. The model reaches n=-4.499 when dividing
   -- 0x1003/0x1FFF (with G_SIZE=16). Reached in step 6.
   f_small_n : cover {n(G_SIZE-1 downto G_SIZE-12) = "101110000000"};

   -- Verify that a division can complete, so f_result is not vacuous
   f_done : cover {m_valid_o = '1'};

   -- Verify that a division with a zero dividend can complete
   f_done_zero : cover {m_valid_o = '1' and f_n = 0};

   -- Verify that the result can wait to be taken, so f_hold is not vacuous
   f_wait : cover {m_valid_o = '1' and m_ready_i = '0'; m_valid_o = '1' and m_ready_i = '1'};

   -- Verify that the next division can start after the result is taken
   f_next : cover {m_valid_o = '1' and m_ready_i = '1'; s_valid_i = '1' and s_ready_o = '1'};


   --------------------------------------------
   -- ASSERTIONS ABOUT INTERNAL STATE
   --------------------------------------------

   -- Verify that the partial remainder stays in the range -4.5 <= n < 4.5.
   -- Together with the covers above, this shows that the range is nearly
   -- tight. Here n = n_s + n_c, see srt_core.vhd.
   f_range_n : assert always n(G_SIZE-1 downto G_SIZE-12) >= X"B80" or
                             n(G_SIZE-1 downto G_SIZE-12) < X"480";

} -- vunit srt_core_inst (srt_core(synthesis))

