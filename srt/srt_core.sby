# Formal verification of srt_core.vhd, see srt_core.psl.
#
# The prove tasks use k-induction, so the properties are proven for every
# clock cycle, not just for a bounded number of them. "prove" uses
# G_SIZE=16, which matches srt_core.gtkw, and "prove32" uses G_SIZE=32, as in
# srt.
#
# The cover task shows that the cover statements in srt_core.psl can be
# reached. With G_SIZE=16 a division takes 18 iterations, and the result is
# ready in step 19, so the depth must be larger than that.
#
# "memory_map -rom-only" turns the thresholds of the columns of the quotient
# digit table (a ROM, see get_col in pla.vhd) into logic. The initial contents
# of a memory only hold in the first clock cycle, but induction starts from an
# arbitrary clock cycle, and could otherwise use any contents.
#
# pla.vhd is read first, since srt_core.vhd uses its package pla_pkg.

[tasks]
cover
prove
prove32

[options]
cover: mode cover
cover: depth 22
prove: mode prove
prove: depth 4
prove32: mode prove
prove32: depth 4

[engines]
smtbmc

[script]
cover: ghdl --std=08 -gG_SIZE=16 pla.vhd pla_pentium.vhd srt_core.vhd srt_core.psl -e srt_core
prove: ghdl --std=08 -gG_SIZE=16 pla.vhd pla_pentium.vhd srt_core.vhd srt_core.psl -e srt_core
prove32: ghdl --std=08 -gG_SIZE=32 pla.vhd pla_pentium.vhd srt_core.vhd srt_core.psl -e srt_core
prep -top srt_core
memory_map -rom-only

[files]
srt_core.psl
srt_core.vhd
pla.vhd
pla_pentium.vhd
